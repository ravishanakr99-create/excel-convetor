# Server
HOST=0.0.0.0
PORT=8000

# Security - generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production

# OpenAI API (for AI extraction)
OPENAI_API_KEY=sk-your-openai-api-key

# Storage: local or s3
STORAGE_TYPE=local
# For S3 compatible (MinIO, AWS S3)
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=pdf-extractor

# Database for history (SQLite by default)
DATABASE_URL=sqlite:///./pdf_extractor.db
